# Language model that writes the draw.io mxfile.
# Used after Kev chooses an intent, and on its own when Kev is not configured
# or cannot be reached. Leave this blank and KEV_BASE_URL blank for demo mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Jared Palmer's Kev (https://github.com/jaredpalmer/kev), the open-source
# Jev-compatible System One server. Optional.
# POST {KEV_BASE_URL}/v1/systemone classifies intent (choice), whether to edit
# (noul), slot choices, and a disruption score.
# Local `kev.serve` needs no API key. KEV_API_KEY is sent as Bearer when set.
KEV_BASE_URL=
KEV_API_KEY=
KEV_MODEL=kev-latest
